# Copy to infra/.env.prod on the server (chmod 600). Never commit the real file.
POSTGRES_PASSWORD=            # openssl rand -hex 24
SECRET_KEY=                   # openssl rand -hex 32
DEBUG=false
APP_URL=https://dm.91.98.93.31.sslip.io
CORS_ORIGINS=https://dm.91.98.93.31.sslip.io
# E-mails allowed to sign in, comma-separated
ALLOWED_EMAILS=
# Magic-link e-mails go through Resend
RESEND_API_KEY=
SENDER_EMAIL=Daily Money <dailymoney@latinosmadrid.es>
# Google sign-in (later): OAuth client ids for web, iOS and Android, comma-separated
GOOGLE_CLIENT_IDS=

# Conexão automática com bancos (opcional: sem as chaves, a tela Conexões mostra "Falta configurar").
# Europa (Wise, Revolut, CaixaBank) via Enable Banking: id do app e chave privada (PEM ou base64).
# Redirect URL cadastrada no painel: <APP_URL>/conexoes/retorno
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Brasil (Nubank, Inter) via Meu Pluggy: credenciais e ids dos itens autorizados (separados por vírgula).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
