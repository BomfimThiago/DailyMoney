# Copie para infra/.env.prod (gitignored) e preencha. Usado tanto pela
# interpolação do compose (POSTGRES_*) quanto como env_file do app.

# ── Postgres (container `db` na network interna) ────────────────────────────
POSTGRES_USER=dailymoney
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE   # ex.: openssl rand -base64 24
POSTGRES_DB=dailymoney

# A app fala com o postgres pelo nome do serviço `db` na porta 5432 (interna).
DATABASE_URL=postgresql://dailymoney:TROQUE_POR_SENHA_FORTE@db:5432/dailymoney?schema=public

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=TROQUE_POR_SEGREDO_LONGO       # openssl rand -base64 48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ── IA de extração: "ollama" (local, grátis) | "openrouter" | "none" ─────────
# Padrão em prod: Ollama em container (serviço `ollama` no compose). Sem chave.
# Baixe o modelo no 1º deploy: docker exec daily-money-ollama ollama pull qwen2.5:3b
EXTRACTION_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b        # 3b = rápido em CPU; troque p/ qwen2.5:7b-instruct p/ +precisão
OLLAMA_VISION_MODEL=           # p/ imagens: ex. llama3.2-vision (exige pull + mais RAM)
OLLAMA_TIMEOUT_MS=900000       # CPU é lento — timeout generoso por chamada

# OpenRouter (alternativa paga/free-tier). Deixe a chave vazia se usar Ollama.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free
OPENROUTER_TEXT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_APP_URL=https://money.91.98.93.31.sslip.io
OPENROUTER_APP_NAME=Daily Money
OPENROUTER_TIMEOUT_MS=300000

# ── FX (Frankfurter / ECB — grátis, sem chave) ──────────────────────────────
FX_BASE_URL=https://api.frankfurter.dev/v1
