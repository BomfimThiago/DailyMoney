# Conexão automática com bancos (opcional: sem as chaves, a tela Conexões mostra "Falta configurar").
# Europa (Wise, Revolut, CaixaBank) via Enable Banking: id do app e chave privada (PEM ou base64).
# Redirect URL cadastrada no painel: <APP_URL>/conexoes/retorno
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Brasil (Nubank, Inter) via Meu Pluggy: credenciais e ids dos itens autorizados (separados por vírgula).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
