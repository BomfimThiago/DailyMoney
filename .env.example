# Postgres (matches docker-compose.yml; host port 5433 to avoid collisions)
DATABASE_URL="postgresql://dailymoney:dailymoney@localhost:5433/dailymoney?schema=public"

# Auth — generate a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-to-a-long-random-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"
# App pessoal: o cadastro fecha depois do primeiro usuário. "true" reabre.
ALLOW_REGISTRATION=""
# Endereço público do app (link de "esqueci a senha").
APP_URL="http://localhost:3000"
# Usuário demo (dados sintéticos) do scripts/seed-demo.ts e dos testes e2e: ponha no .env.local.
# DEMO_EMAIL=""
# DEMO_PASSWORD=""

# AI extraction provider: "openrouter" | "ollama" | "none".
#
# ── Ollama (local, grátis, sem chave) ────────────────────────────────────────
# Rode o servidor (`ollama serve`) e baixe o modelo (`ollama pull qwen2.5:7b-instruct`).
# Para PDFs a camada de texto é extraída localmente e enviada ao modelo de texto;
# imagens exigem um modelo de visão em OLLAMA_VISION_MODEL (ex.: llama3.2-vision).
# Para usar, troque EXTRACTION_PROVIDER para "ollama".
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
OLLAMA_VISION_MODEL=""
OLLAMA_TIMEOUT_MS="300000"
#
# ── OpenRouter (free tier). Leave OPENROUTER_API_KEY empty to
# disable AI extraction (CSV/XLSX still work fully without it).
# NOTE: free models change slugs and get rate-limited (HTTP 429). Check the current
# free vision models at https://openrouter.ai/models?max_price=0 and update below.
# Free-tier PDF extraction is slow (~2-3 min); uploads are processed in the
# background and the UI polls until STAGED/FAILED.
EXTRACTION_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
# Comma-separated FALLBACK list — tries each until one works (free models get
# pulled/rate-limited). Check current free vision models: https://openrouter.ai/models?max_price=0
OPENROUTER_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free"
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Daily Money"
# Max wait for one AI extraction call. Free models are slow — 5 min default.
OPENROUTER_TIMEOUT_MS="300000"

# FX rates (Frankfurter / ECB — free, no key needed)
FX_BASE_URL="https://api.frankfurter.dev/v1"

# Pluggy (Open Finance BR) — Meu Pluggy, uso pessoal e gratuito. Credenciais da Application
# no Dashboard da Pluggy; itemIds em Applications › Demo › Connected Items (vírgula entre eles).
PLUGGY_APP_ID=""
PLUGGY_APP_SECRET=""
PLUGGY_ITEM_IDS=""
PLUGGY_API_URL="https://api.pluggy.ai"

# Enable Banking (Open Banking na Europa) — modo restrito, grátis para as próprias contas.
# No painel (enablebanking.com/cp): registre uma aplicação de PRODUÇÃO, cadastre o endereço
# de retorno https://<seu app>/connections/callback e clique em "Activate by linking
# accounts" para vincular cada conta. O painel baixa a chave privada <app-id>.pem:
# aponte para o arquivo ou cole aqui (PEM, ou PEM em base64 numa linha: base64 -i app.pem).
ENABLE_BANKING_APP_ID=""
ENABLE_BANKING_KEY_FILE=""
ENABLE_BANKING_PRIVATE_KEY=""
# Servidor falso para testes: http://localhost:3999 (npx tsx scripts/fake-enablebanking.ts).
ENABLE_BANKING_API_URL="https://api.enablebanking.com"
# Igual ao cadastrado no painel. Vazio = <endereço do app>/connections/callback.
ENABLE_BANKING_REDIRECT_URL=""

# Rotina diária (contêiner `cron` em produção): segredo do POST /api/cron/sync.
# Gere com: openssl rand -hex 32. Vazio = rota desligada.
CRON_SECRET=""
